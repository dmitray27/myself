CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_LWIP_MAX_SOCKETS=8

# GPIO layout of the ESP32-WROOM stand (see main/Kconfig.projbuild).
# For ESP32-S3 the same symbols are overridden in sdkconfig.defaults.esp32s3.
CONFIG_PIN_FQ_UD=18
CONFIG_PIN_W_CLK=19
CONFIG_PIN_DATA=21
CONFIG_PIN_RESET=16
CONFIG_PIN_PTT=15
CONFIG_PIN_I2S_BCK=26
CONFIG_PIN_I2S_WS=25
CONFIG_PIN_I2S_DATA=22
